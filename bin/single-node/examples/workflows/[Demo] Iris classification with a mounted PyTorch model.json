    {
      "operatorID": "PythonUDFV2-operator-Classify-with-mounted-PyTorch-model",
      "operatorType": "PythonUDFV2",
      "operatorVersion": "N/A",
      "operatorProperties": {
        "code": "from pytexera import *\n\nimport os\nimport torch\n\nFEATURES = [\"SepalLengthCm\", \"SepalWidthCm\", \"PetalLengthCm\", \"PetalWidthCm\"]\n\n\nclass ProcessBatchOperator(UDFBatchOperator):\n    \"\"\"Scores Iris rows with a PyTorch model read from a mounted model version.\n\n    IRIS_MODEL is picked in the property panel: it holds the local path of the model\n    version mounted on this computing unit. The mount is a read-only GeeseFS FUSE\n    view of the LakeFS commit, so the ~1GB checkpoint is streamed on demand rather\n    than downloaded into the pod first.\n    \"\"\"\n\n    BATCH_SIZE = 32\n\n    @overrides\n    def open(self):\n        # Chosen in the property panel; the value is the directory this model\n        # version is mounted at inside the computing unit.\n        IRIS_MODEL = self.UiParameter(\"IRIS_MODEL\", AttributeType.STRING, value=Resource.MODEL).value\n        checkpoint = torch.load(\n            os.path.join(IRIS_MODEL, \"iris_embedding_classifier.pt\"),\n            map_location=\"cpu\",\n            weights_only=True,\n        )\n        state, meta = checkpoint[\"state_dict\"], checkpoint[\"meta\"]\n        self.classes = meta[\"classes\"]\n        self.mean, self.std = state[\"norm.mean\"], state[\"norm.std\"]\n        # 1,000,000 x 256 float32: nearly all of the checkpoint's size, and the reason\n        # this model is expensive to store but not to run.\n        self.embedding = state[\"embedding.weight\"]\n        self.weights = [state[f\"head.net.{i}.weight\"] for i in (0, 2, 4)]\n        self.biases = [state[f\"head.net.{i}.bias\"] for i in (0, 2, 4)]\n\n    @overrides\n    def process_batch(self, batch: Batch, port: int) -> Iterator[Optional[BatchLike]]:\n        x = torch.from_numpy(batch[FEATURES].to_numpy(dtype=\"float32\"))\n\n        # Trained 4 -> 64 -> 32 -> 3 classifier head; this is what decides the label.\n        h = (x - self.mean) / self.std\n        for weight, bias in zip(self.weights[:-1], self.biases[:-1]):\n            h = torch.relu(h @ weight.T + bias)\n        probabilities = torch.softmax(h @ self.weights[-1].T + self.biases[-1], dim=1)\n        confidence, predicted = probabilities.max(dim=1)\n\n        # One gather per row out of the 1M-row bank: random access into a mounted\n        # tensor costs a page fetch, not a scan of the file.\n        keys = (x * 10).long().sum(dim=1).abs() % self.embedding.shape[0]\n        signature = self.embedding[keys].norm(dim=1)\n\n        batch[\"predicted_species\"] = [self.classes[i] for i in predicted.tolist()]\n        batch[\"confidence\"] = [round(c, 4) for c in confidence.tolist()]\n        batch[\"embedding_signature\"] = [round(v, 4) for v in signature.tolist()]\n        yield batch\n",
        "workers": 1,
        "retainInputColumns": true,
        "defaultEnv": true,
        "envName": "",
        "outputColumns": [
          {
            "attributeName": "predicted_species",
            "attributeType": "string"
          },
          {
            "attributeName": "confidence",
            "attributeType": "double"
          },
          {
            "attributeName": "embedding_signature",
            "attributeType": "double"
          }
        ],
        "uiParameters": [
          {
            "attribute": {
              "attributeName": "IRIS_MODEL",
              "attributeType": "string"
            },
            "inputType": "model",
            "value": "/models/texera/iris-embedding-classifier/v1 - v1"
          }
        ]
      },
